# --- Discord bot / app ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# A discord szerver (guild) ID-je, ahol a bot a logokat gyűjti, és amihez
# a weboldali bejelentkezést korlátozzuk.
DISCORD_GUILD_ID=

# Opcionális: csak ezzel a role ID-vel rendelkező tagok léphetnek be a weboldalra.
# Ha üresen hagyod, bárki beléphet, aki tagja a fenti guildnek.
STAFF_ROLE_ID=

# --- Database ---
DATABASE_URL="mysql://dclog:dclog@localhost:3306/dclog"

# --- Web (NextAuth) ---
# Generáld: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
